{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexara File Convert",
  "version": "0.1.0",
  "identifier": "com.nexara.fileconvert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexara File Convert",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Nexara",
    "copyright": "Copyright © 2026 Nexara",
    "shortDescription": "Universal file conversion, processed locally.",
    "longDescription": "Nexara File Convert is a local, private, universal file conversion utility for Windows. Convert video, audio, images, documents, spreadsheets, presentations, archives, e-books, PDFs, and vector graphics — entirely on your own computer, with no upload, no account, and no cloud dependency.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/engines/7zip/*",
      "resources/engines/imagemagick/*",
      "resources/engines/inkscape/*",
      "resources/engines/pandoc/*",
      "resources/engines/ffmpeg/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
